<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net9.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <Version>3.0.3</Version>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>Latest</LangVersion>
    <AssemblyName>ShortcutBay</AssemblyName>
    <ApplicationIcon>Resources\shortcutbay.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Alexander Prokopchuk</Authors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CA1416;WFO5001</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;CA1416;WFO5001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="ListViewItemMenu.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="SearchTextBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ShellLinkListView.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="SystemHotkey.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="TrayMenu.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <Target Name="PackChoco" DependsOnTargets="Publish">
    <Message Importance="High" Text="Packing $(PublishDir), generating nuspec:" />
    <Exec Command="python3 generate-choco-spec.py $(PublishDir)" />
    <Exec Command="choco pack shortcutbay.choco.nuspec" />
  </Target>
  <ItemGroup>
    <Reference Include="Resources\Interop.IWshRuntimeLibrary.dll" />
    <!--<COMReference Include="IWshRuntimeLibrary">
      <Guid>{F935DC20-1CF0-11D0-ADB9-00C04FD58A0B}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </COMReference>-->
  </ItemGroup>
</Project>
